CHAPTER=chap13
APP_NAME=AdvancedAuthorizationApplication
SERVICES=mariadb,mongodb,redis,vault
MODULE_TYPE=single
MARIADB_PORT=3306
SQL_INIT_PATH=../sql/chap13-init.sql
MONGODB_PORT=27017
MONGODB_INIT_PATH=../mongodb/chap13-mongo-init.js
REDIS_PORT=6379
VAULT_PORT=8200
VAULT_INIT_PATH=../vault/vault-init.sh
VAULT_CONFIGURATIONS="echo 'Configuring AdvancedAuthorizationApplication...' && \
             vault kv put secret/AdvancedAuthorizationApplication/local \
               spring.datasource.driver-class-name=org.mariadb.jdbc.Driver \
               spring.datasource.url=jdbc:mariadb://localhost:3306/primavera \
               spring.datasource.username=primavera \
               spring.datasource.password=primavera \
               spring.data.mongodb.uri=mongodb://primavera:primavera@localhost:27017/primavera?authSource=admin \
               spring.data.redis.host=localhost \
               spring.data.redis.port=6379 \
               spring.data.redis.password=primavera"
VAULT_DEPENDS_ON="mariadb-${CHAPTER}:
        condition: service_healthy"
