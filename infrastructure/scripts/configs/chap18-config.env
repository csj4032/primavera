CHAPTER=chap18
APP_NAME=ComplexMicroserviceApplication
SERVICES=mariadb,mongodb,redis,kafka,vault
MODULE_TYPE=multi
SUB_MODULES=account=AccountServiceApplication,configuration=ConfigurationServiceApplication,front=FrontServiceApplication,order=OrderServiceApplication,product=ProductServiceApplication
MARIADB_PORT=3324
SQL_INIT_PATH=../sql/chap18-init.sql
MONGODB_PORT=27197
MONGODB_INIT_PATH=../mongodb/chap18-mongo-init.js
REDIS_PORT=6559
KAFKA_PORT=9272
ZOOKEEPER_PORT=2361
VAULT_PORT=8380
VAULT_INIT_PATH=../vault/vault-init.sh
VAULT_CONFIGURATIONS="echo 'Configuring ComplexMicroserviceApplication...' && \
             vault kv put secret/ComplexMicroserviceApplication/local \
               spring.datasource.driver-class-name=org.mariadb.jdbc.Driver \
               spring.datasource.url=jdbc:mariadb://mariadb-chap18:3306/primavera \
               spring.datasource.username=primavera \
               spring.datasource.password=primavera \
               spring.data.mongodb.uri=mongodb://primavera:primavera@mongodb-chap18:27017/primavera?authSource=admin \
               spring.data.redis.host=redis-chap18 \
               spring.data.redis.port=6379 \
               spring.data.redis.password=primavera && \
             echo 'Configuring AccountServiceApplication (account module)...' && \
             vault kv put secret/AccountServiceApplication/local \
               server.port=8087 \
               spring.datasource.driver-class-name=org.mariadb.jdbc.Driver \
               spring.datasource.url=jdbc:mariadb://mariadb-chap18:3306/primavera \
               spring.datasource.username=primavera \
               spring.datasource.password=primavera \
               spring.data.mongodb.uri=mongodb://primavera:primavera@mongodb-chap18:27017/primavera?authSource=admin \
               spring.data.redis.host=redis-chap18 \
               spring.data.redis.port=6379 \
               spring.data.redis.password=primavera && \
             echo 'Configuring ConfigurationServiceApplication (configuration module)...' && \
             vault kv put secret/ConfigurationServiceApplication/local \
               server.port=8093 \
               spring.datasource.driver-class-name=org.mariadb.jdbc.Driver \
               spring.datasource.url=jdbc:mariadb://mariadb-chap18:3306/primavera \
               spring.datasource.username=primavera \
               spring.datasource.password=primavera \
               spring.data.mongodb.uri=mongodb://primavera:primavera@mongodb-chap18:27017/primavera?authSource=admin \
               spring.data.redis.host=redis-chap18 \
               spring.data.redis.port=6379 \
               spring.data.redis.password=primavera && \
             echo 'Configuring FrontServiceApplication (front module)...' && \
             vault kv put secret/FrontServiceApplication/local \
               server.port=8085 \
               spring.datasource.driver-class-name=org.mariadb.jdbc.Driver \
               spring.datasource.url=jdbc:mariadb://mariadb-chap18:3306/primavera \
               spring.datasource.username=primavera \
               spring.datasource.password=primavera \
               spring.data.mongodb.uri=mongodb://primavera:primavera@mongodb-chap18:27017/primavera?authSource=admin \
               spring.data.redis.host=redis-chap18 \
               spring.data.redis.port=6379 \
               spring.data.redis.password=primavera && \
             echo 'Configuring OrderServiceApplication (order module)...' && \
             vault kv put secret/OrderServiceApplication/local \
               server.port=8085 \
               spring.datasource.driver-class-name=org.mariadb.jdbc.Driver \
               spring.datasource.url=jdbc:mariadb://mariadb-chap18:3306/primavera \
               spring.datasource.username=primavera \
               spring.datasource.password=primavera \
               spring.data.mongodb.uri=mongodb://primavera:primavera@mongodb-chap18:27017/primavera?authSource=admin \
               spring.data.redis.host=redis-chap18 \
               spring.data.redis.port=6379 \
               spring.data.redis.password=primavera && \
             echo 'Configuring ProductServiceApplication (product module)...' && \
             vault kv put secret/ProductServiceApplication/local \
               server.port=8087 \
               spring.datasource.driver-class-name=org.mariadb.jdbc.Driver \
               spring.datasource.url=jdbc:mariadb://mariadb-chap18:3306/primavera \
               spring.datasource.username=primavera \
               spring.datasource.password=primavera \
               spring.data.mongodb.uri=mongodb://primavera:primavera@mongodb-chap18:27017/primavera?authSource=admin \
               spring.data.redis.host=redis-chap18 \
               spring.data.redis.port=6379 \
               spring.data.redis.password=primavera"
VAULT_DEPENDS_ON="mariadb-${CHAPTER}:
        condition: service_healthy"
