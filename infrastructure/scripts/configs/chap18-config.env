CHAPTER=chap18
APP_NAME=ComplexMicroserviceApplication
SERVICES=mariadb,mongodb,redis,kafka,vault
MODULE_TYPE=multi
SUB_MODULES=account=AccountApplication,configuration=ConfigurationApplication,front=FrontApplication,order=OrderApplication,product=ProductApplication
MARIADB_PORT=3306
SQL_INIT_PATH=../sql/chap18-init.sql
MONGODB_PORT=27017
MONGODB_INIT_PATH=../mongodb/chap18-mongo-init.js
REDIS_PORT=6379
KAFKA_PORT=9092
ZOOKEEPER_PORT=2181
VAULT_PORT=8200
VAULT_INIT_PATH=../vault/vault-init.sh
VAULT_CONFIGURATIONS="echo 'Configuring account service...' && \
             vault kv put secret/account/local \
               server.port=8080 \
               spring.data.redis.host=localhost \
               spring.data.redis.port=6379 \
               spring.data.redis.password=primavera \
               spring.r2dbc.url=r2dbc:mariadb://localhost:3306/primavera \
               spring.r2dbc.username=primavera \
               spring.r2dbc.password=primavera && \
             echo 'Configuring front service...' && \
             vault kv put secret/front/local \
               server.port=8081 \
               primavera.services.account-url=http://localhost:8080 \
               primavera.services.order-url=http://localhost:8082 \
               primavera.services.product-url=http://localhost:8083 && \
             echo 'Configuring order service...' && \
             vault kv put secret/order/local \
               server.port=8082 \
               spring.r2dbc.url=r2dbc:mariadb://localhost:3306/primavera \
               spring.r2dbc.username=primavera \
               spring.r2dbc.password=primavera \
               spring.kafka.bootstrap-servers=localhost:9092 \
               spring.kafka.consumer.group-id=order-service && \
             echo 'Configuring product service...' && \
             vault kv put secret/product/local \
               server.port=8083 \
               spring.data.mongodb.host=localhost \
               spring.data.mongodb.port=27017 \
               spring.data.mongodb.database=primavera_products \
               spring.data.mongodb.username=root \
               spring.data.mongodb.password=root \
               spring.data.mongodb.authentication-database=admin \
               spring.kafka.bootstrap-servers=localhost:9092 \
               spring.kafka.consumer.group-id=product-service"
VAULT_DEPENDS_ON="mariadb-${CHAPTER}:
        condition: service_healthy"
