CHAPTER=chap14
APP_NAME=AdvancedJpaApplication
SERVICES=mariadb,mongodb,vault
MODULE_TYPE=single
MARIADB_PORT=3320
SQL_INIT_PATH=../sql/chap14-init.sql
MONGODB_PORT=27157
MONGODB_INIT_PATH=../mongodb/chap14-mongo-init.js
VAULT_PORT=8340
VAULT_INIT_PATH=../vault/vault-init.sh
VAULT_CONFIGURATIONS="echo 'Configuring AdvancedJpaApplication...' && \
             vault kv put secret/AdvancedJpaApplication/local \
               spring.datasource.driver-class-name=org.mariadb.jdbc.Driver \
               spring.datasource.url=jdbc:mariadb://mariadb-chap14:3306/primavera \
               spring.datasource.username=primavera \
               spring.datasource.password=primavera \
               spring.data.mongodb.uri=mongodb://primavera:primavera@mongodb-chap14:27017/primavera?authSource=admin"
VAULT_DEPENDS_ON="mariadb-${CHAPTER}:
        condition: service_healthy"
