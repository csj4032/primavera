CHAPTER=chap17
APP_NAME=MicroserviceApplication
SERVICES=mariadb-cdc,elasticsearch,vault
MODULE_TYPE=multi
SUB_MODULES=batch=ProductBatchApplication,streaming=ProductStreamingApplication
MARIADB_PORT=3306
SQL_INIT_PATH=../sql/chap17-init.sql
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9300
VAULT_PORT=8200
VAULT_INIT_PATH=../vault/vault-init.sh
VAULT_CONFIGURATIONS="echo 'Configuring MicroserviceApplication...' && \
             vault kv put secret/MicroserviceApplication/local \
               spring.datasource.driver-class-name=org.mariadb.jdbc.Driver \
               spring.datasource.url=jdbc:mariadb://localhost:3306/primavera \
               spring.datasource.username=primavera \
               spring.datasource.password=primavera \
               spring.elasticsearch.uris=http://localhost:9200 && \
             echo 'Configuring ProductBatchApplication (batch module)...' && \
             vault kv put secret/ProductBatchApplication/local \
               spring.datasource.driver-class-name=org.mariadb.jdbc.Driver \
               spring.datasource.url=jdbc:mariadb://localhost:3306/primavera \
               spring.datasource.username=primavera \
               spring.datasource.password=primavera \
               spring.batch.initialize-schema=always \
               spring.elasticsearch.uris=http://localhost:9200 && \
             echo 'Configuring ProductStreamingApplication (streaming module)...' && \
             vault kv put secret/ProductStreamingApplication/local \
               server.port=8081 \
               spring.webflux.base-path=/streaming"
VAULT_DEPENDS_ON="mariadb-${CHAPTER}:
        condition: service_healthy"
