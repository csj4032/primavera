CHAPTER=chap12
APP_NAME=HierarchicalCommentApplication
SERVICES=mariadb,vault
MODULE_TYPE=single
MARIADB_PORT=3318
SQL_INIT_PATH=../sql/chap12-init.sql
VAULT_PORT=8320
VAULT_INIT_PATH=../vault/vault-init.sh
VAULT_CONFIGURATIONS="echo 'Configuring HierarchicalCommentApplication...' && \
             vault kv put secret/HierarchicalCommentApplication/local \
               spring.datasource.driver-class-name=org.mariadb.jdbc.Driver \
               spring.datasource.url=jdbc:mariadb://localhost:3318/primavera \
               spring.datasource.username=primavera \
               spring.datasource.password=primavera"
VAULT_DEPENDS_ON="mariadb-${CHAPTER}:
        condition: service_healthy"
