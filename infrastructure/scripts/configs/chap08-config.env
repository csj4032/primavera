CHAPTER=chap08
APP_NAME=SecurityFilterApplication
SERVICES=mariadb,vault
MODULE_TYPE=single
MARIADB_PORT=3314
SQL_INIT_PATH=../sql/chap08-init.sql
VAULT_PORT=8280
VAULT_INIT_PATH=../vault/vault-init.sh
VAULT_CONFIGURATIONS="echo 'Configuring SecurityFilterApplication...' && \
             vault kv put secret/SecurityFilterApplication/local \
               spring.datasource.driver-class-name=org.mariadb.jdbc.Driver \
               spring.datasource.url=jdbc:mariadb://localhost:3314/primavera \
               spring.datasource.username=primavera \
               spring.datasource.password=primavera"
VAULT_DEPENDS_ON="mariadb-${CHAPTER}:
        condition: service_healthy"
