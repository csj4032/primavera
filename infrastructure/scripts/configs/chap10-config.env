CHAPTER=chap10
APP_NAME=OAuth2SocialLoginApplication
SERVICES=mariadb,redis,vault
MODULE_TYPE=single
MARIADB_PORT=3316
SQL_INIT_PATH=../sql/chap10-init.sql
REDIS_PORT=6479
VAULT_PORT=8300
VAULT_INIT_PATH=../vault/vault-init.sh
VAULT_CONFIGURATIONS="echo 'Configuring OAuth2SocialLoginApplication...' && \
             vault kv put secret/OAuth2SocialLoginApplication/local \
               spring.datasource.driver-class-name=org.mariadb.jdbc.Driver \
               spring.datasource.url=jdbc:mariadb://localhost:3316/primavera \
               spring.datasource.username=primavera \
               spring.datasource.password=primavera \
               spring.data.redis.host=localhost \
               spring.data.redis.port=6479 \
               spring.data.redis.password=primavera"
VAULT_DEPENDS_ON="mariadb-${CHAPTER}:
        condition: service_healthy"
