CHAPTER=chap07
APP_NAME=ThymeleafWebApplication
SERVICES=mariadb,vault
MODULE_TYPE=single
MARIADB_PORT=3313
SQL_INIT_PATH=../sql/chap07-init.sql
VAULT_PORT=8270
VAULT_INIT_PATH=../vault/vault-init.sh
VAULT_CONFIGURATIONS="echo 'Configuring ThymeleafWebApplication...' && \
             vault kv put secret/ThymeleafWebApplication/local \
               spring.datasource.driver-class-name=org.mariadb.jdbc.Driver \
               spring.datasource.url=jdbc:mariadb://localhost:3313/primavera \
               spring.datasource.username=primavera \
               spring.datasource.password=primavera"
VAULT_DEPENDS_ON="mariadb-${CHAPTER}:
        condition: service_healthy"
