CHAPTER=chap09
APP_NAME=SpringSecurityBasicApplication
SERVICES=mariadb,vault
MODULE_TYPE=single
MARIADB_PORT=3315
SQL_INIT_PATH=../sql/chap09-init.sql
VAULT_PORT=8290
VAULT_INIT_PATH=../vault/vault-init.sh
VAULT_CONFIGURATIONS="echo 'Configuring SpringSecurityBasicApplication...' && \
             vault kv put secret/SpringSecurityBasicApplication/local \
               spring.datasource.driver-class-name=org.mariadb.jdbc.Driver \
               spring.datasource.url=jdbc:mariadb://localhost:3315/primavera \
               spring.datasource.username=primavera \
               spring.datasource.password=primavera"
VAULT_DEPENDS_ON="mariadb-${CHAPTER}:
        condition: service_healthy"
