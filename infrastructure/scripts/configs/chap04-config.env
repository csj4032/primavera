CHAPTER=chap04
APP_NAME=DataAccessApplication
SERVICES=mariadb,vault
MODULE_TYPE=single
MARIADB_PORT=3310
SQL_INIT_PATH=../sql/chap04-init.sql
VAULT_PORT=8240
VAULT_INIT_PATH=../vault/vault-init.sh
VAULT_CONFIGURATIONS="echo 'Configuring DataAccessApplication...' && \
             vault kv put secret/DataAccessApplication/local \
               spring.datasource.driver-class-name=org.mariadb.jdbc.Driver \
               spring.datasource.url=jdbc:mariadb://localhost:3310/primavera \
               spring.datasource.username=primavera \
               spring.datasource.password=primavera"
VAULT_DEPENDS_ON="mariadb-${CHAPTER}:
        condition: service_healthy"
