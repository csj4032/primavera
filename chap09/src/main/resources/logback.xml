<configuration>
    <!-- Include default properties and patterns -->
    <include resource="logging/logback/defaults.xml" />
    
    <!-- Include appender configurations -->
    <include resource="logging/logback/console-appender.xml" />
    <include resource="logging/logback/file-appender.xml" />
    
    <!-- Application startup and configuration loggers -->
    <logger name="com.genius.primavera" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="STARTUP_FILE" />
    </logger>
    
    <!-- Spring Boot startup information -->
    <logger name="org.springframework.boot" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="STARTUP_FILE" />
    </logger>
    
    <!-- Spring Framework context and beans -->
    <logger name="org.springframework.context" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="STARTUP_FILE" />
    </logger>
    
    <!-- Spring Security configuration and authentication -->
    <logger name="org.springframework.security" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="SECURITY_FILE" />
    </logger>
    
    <!-- OAuth2 specific logging -->
    <logger name="org.springframework.security.oauth2" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="OAUTH2_FILE" />
    </logger>
    
    <!-- Database and MyBatis logging -->
    <logger name="org.springframework.jdbc" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>
    
    <!-- SQL logging with log4jdbc -->
    <logger name="jdbc.sqlonly" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>
    
    <logger name="jdbc.sqltiming" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>
    
    <!-- Web server startup (Undertow) -->
    <logger name="io.undertow" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="STARTUP_FILE" />
    </logger>
    
    <!-- SSL/TLS configuration -->
    <logger name="javax.net.ssl" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="STARTUP_FILE" />
    </logger>
    
    <!-- Thymeleaf template engine -->
    <logger name="org.thymeleaf" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>
    
    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>
</configuration>